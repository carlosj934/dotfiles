# Theme
theme = nord
background = #282c35
background-image = /Users/carlos/.config/ghostty/gitlab_grey.png
background-image-opacity = 0.2
background-image-fit = cover
background-image-position = center
# Neutral white instead of Nord's blue-tinted #d8dee9, 10% brighter
foreground = #E7E7E7

# Font
font-size = 13
font-thicken = true
font-thicken-strength = 0
font-family = "JetBrainsMono Nerd Font Mono"

# Cursor
cursor-style = bar
cursor-style-blink = true
cursor-color = #A3BE8C
mouse-hide-while-typing = true

# Launch herdr on startup, falling back to a plain shell if it's missing.
command = zsh --login -c "if command -v herdr >/dev/null 2>&1; then herdr; else zsh; fi"

# Window
macos-titlebar-style = hidden
window-save-state = always
maximize = true
confirm-close-surface = false
quick-terminal-position = center

# Padding (left, right, top, bottom → x/y in Ghostty)
window-padding-x = 4,0
window-padding-y = 2,0

# Keybinds (Ctrl+Enter / Shift+Enter CSI u sequences)
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u

# Send Option as a real Alt modifier (so alt+v works instead of typing √)
macos-option-as-alt = true
