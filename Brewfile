# Polyglot runtime/tool version manager (Go, Python, Node, etc.)
brew "mise"
# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"
# Parser generator tool (nvim-treesitter `main` shells out to `tree-sitter build`)
brew "tree-sitter-cli"
# Search tool like grep and The Silver Searcher (used by Telescope)
brew "ripgrep"
# Command-line fuzzy finder written in Go
brew "fzf"
# Lightweight command-line JSON processor (used by herdr/nav.sh)
brew "jq"
# Modern, maintained replacement for ls
brew "eza"
# A better cd command
brew "zoxide"
# Simple terminal UI for git commands
brew "lazygit"
# Blazing fast terminal file manager written in Rust, based on async I/O
brew "yazi"
# Cross-shell prompt for astronauts
brew "starship"
# Agent multiplexer that lives in your terminal (tmux replacement) - pairs with opencode
brew "herdr"
# Fish-like fast/unobtrusive autosuggestions for zsh
brew "zsh-autosuggestions"
# Fish shell like syntax highlighting for zsh
brew "zsh-syntax-highlighting"
# Platform built on V8 to build network applications (needed by some Mason-installed tools, e.g. prettier)
brew "node"
# GNU compiler collection (needed for cgo builds in Go)
brew "gcc"

# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Developer targeted font with ligatures + icons, used by Ghostty/Starship/Neovim
cask "font-jetbrains-mono-nerd-font"
